_daykeep()
{
	local cur prev words cword split
	_init_completion -s || return

	case $prev in
	-f | --file | -a | --append)
		_filedir
		return
		;;
	--format)
		COMPREPLY=($(compgen -W 'decimal hm minutes' -- "$cur"))
		return
		;;
	--epoch | --day-length | --help | --version)
		return
		;;
	esac
	$split && return

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W '--file= --summarize --format= --hm --now
			--convert --track --append= --utc --epoch= --day-length= --help --version' -- "$cur"))
		[[ ${COMPREPLY-} == *= ]] && compopt -o nospace
	fi
} &&
	complete -F _daykeep daykeep
